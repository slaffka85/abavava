# === Backend Java-трека (префикс ABV_, совместим с Go-треком) ===
# Скопируйте в .env и задайте собственные значения. Эти dev-настройки
# нельзя использовать в production.
#
# Полный набор настроек и все значения по умолчанию — в application.yml:
# прикладные в секции abv: (переопределяются переменными ABV_*, например
# abv.http-addr ← ABV_HTTP_ADDR), БД — стандартные spring.datasource.*.
# Здесь — самые частые.

ABV_ENV=development
# Порт Java-трека (Go-трек занимает :8080)
ABV_HTTP_ADDR=:8082

# PostgreSQL Java-трека (docker compose up -d postgres → порт 5433)
# Java-трек ходит в БД по JDBC-URL — формат postgres://... понимает только
# Go-трек. Логин/пароль — отдельными переменными.
ABV_DATABASE_URL=jdbc:postgresql://localhost:5433/abavava?sslmode=disable
ABV_DATABASE_USERNAME=abavava
ABV_DATABASE_PASSWORD=abavava
# Перейти на общую БД с Go-треком: jdbc:postgresql://localhost:5432/abv?sslmode=disable
# пользователь abv, пароль abv

# Секрет подписи JWT. В продакшене обязателен случайный минимум 32 символа.
# Сгенерируйте случайный секрет (не менее 32 символов), например:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
ABV_JWT_SECRET=

ABV_ACCESS_TTL=15m
ABV_REFRESH_TTL=720h
ABV_CALL_RING_TIMEOUT=45s
# Optional: path to Firebase service account JSON (keep this secret outside the repository).
ABV_FCM_SERVICE_ACCOUNT_FILE=
ABV_MAX_MESSAGE_LENGTH=4000
ABV_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
ABV_LOG_LEVEL=info
ABV_MIGRATE_ON_START=true

# TURN (опционально)
ABV_TURN_URL=
ABV_TURN_USERNAME=
ABV_TURN_CREDENTIAL=
