# Copy to /opt/abavava/.env.production on the VPS. Never commit the filled file.
ABV_DOMAIN=chat.example.com
ABV_DATABASE_PASSWORD=replace-with-a-long-random-password
ABV_JWT_SECRET=replace-with-at-least-32-random-characters
ABV_LOG_LEVEL=info

# Optional TURN server for WebRTC calls. Leave empty when not configured.
ABV_TURN_URL=
ABV_TURN_USERNAME=
ABV_TURN_CREDENTIAL=
